#!/bin/bash
set -e

source "./scripts/_env"

# ─── Test ────────────────────────────────────────────────────────────────────

run_test() {
  echo "🧪 Testing project..."
  # A free-threaded environment holds what it can install, which syncing every extra would undo.
  if is_free_threaded; then
    uv run --no-sync pytest -n auto "$@"
  else
    uv run pytest -n auto "$@"
  fi
  echo "✅ Test complete."
}

if [[ "${#BASH_SOURCE[@]}" -eq 1 ]]; then
  run_test "$@"
fi
